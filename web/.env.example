# Salin jadi .env lalu isi. (install.sh membuatnya otomatis.)
FREEASE_PASSWORD=ganti-dengan-kata-sandi
FREEASE_SECRET=ganti-dengan-teks-acak-panjang
FREEASE_REGION=ID
FREEASE_LANG=id
# Domain untuk HTTPS (profil https), mis. musik.domainmu.com
DOMAIN=
# Semua alamat yang dilayani Caddy (diisi install.sh), mis. "freease.cloud www.freease.cloud"
SITES=
# Cookies YouTube bila server tetap diblokir (taruh berkasnya di ./data/cookies.txt)
# YT_COOKIES_FILE=/app/data/cookies.txt
