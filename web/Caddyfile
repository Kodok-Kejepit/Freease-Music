# Dipakai layanan "caddy" di docker-compose (profil https).
#   DOMAIN = alamat utama (mis. freease.cloud)
#   SITES  = semua alamat yang dilayani, dipisah spasi (mis. "freease.cloud www.freease.cloud"); alamat selain
#            DOMAIN dialihkan ke DOMAIN. install.sh mengisinya otomatis.
{
	servers {
		# Tutup koneksi yang lambat mengirim header (serangan slowloris); streaming audio tidak terpengaruh.
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

{$SITES} {
	@other not host {$DOMAIN}
	redir @other https://{$DOMAIN}{uri} permanent

	encode zstd gzip
	request_body {
		max_size 1MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy freease:8080 {
		# Streaming audio: teruskan langsung tanpa ditahan.
		flush_interval -1
	}
}
